# Copy to .env and fill in for local development.
# Never commit a real .env with production secrets.

# --- Auth ---
# Comma-separated list of valid API keys. If unset, a dev key is generated
# and printed once at startup.
DEBRIS_TRACKER_API_KEYS=your-dev-key-here

# --- App ---
ORBITGUARD_ENV=development

# --- Database ---
# SQLite (default, zero-setup local dev):
ORBITGUARD_DATABASE_URL=sqlite:///./orbitguard.db
# Postgres (production / docker-compose):
# ORBITGUARD_DATABASE_URL=postgresql+psycopg2://orbitguard:orbitguard@localhost:5432/orbitguard

# --- CORS ---
ORBITGUARD_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Ingestion ---
ORBITGUARD_CELESTRAK_URL=https://celestrak.org/NORAD/elements/gp.php
ORBITGUARD_INGESTION_TIMEOUT=20
ORBITGUARD_USE_SYNTHETIC_FALLBACK=true

# --- Screening defaults ---
ORBITGUARD_WINDOW_HOURS=24
ORBITGUARD_STEP_SECONDS=30
ORBITGUARD_MISS_DISTANCE_KM=25
ORBITGUARD_ALTITUDE_MARGIN_KM=150

# --- Alerting ---
ORBITGUARD_ALERT_MISS_DISTANCE_KM=5

# --- Background jobs ---
ORBITGUARD_ENABLE_JOBS=false
ORBITGUARD_INGESTION_REFRESH_MINUTES=180
ORBITGUARD_SCREENING_REFRESH_MINUTES=15

# --- Trajectory cache ---
ORBITGUARD_TRAJECTORY_CACHE_SIZE=512
